{
  "name": "crics-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "seo:headers": "node scripts/check-seo-headers.mjs",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "lint": "eslint . && tsc --noEmit",
    "check": "npm run lint && npm run test && npm run build",
    "check:all": "npm run lint && npm run test && npm run build && npm run test:e2e",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "dexie": "4.4.7",
    "html-to-image": "1.11.13",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "jsqr": "1.4.0",
    "lucide-react": "0.546.0",
    "qrcode": "1.5.4",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.14.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "pdfjs-dist": "6.5.438",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
